{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/examples/**"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["* * 1,15 * *"]
    },
    {
      "matchFileNames": [".tool-versions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "tool-versions"
    },
    {
      "matchPackageNames": [
        "github.com/onsi/ginkgo/v2",
        "github.com/onsi/gomega",
        "github.com/stretchr/testify"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "test-dependencies"
    },
    {
      "description": "controller-runtime is built against a specific k8s.io minor. Upgrading either alone produces a combination that is not in the compatibility matrix, so they must land together.",
      "matchPackageNames": [
        "sigs.k8s.io/controller-runtime",
        "k8s.io/api",
        "k8s.io/apiextensions-apiserver",
        "k8s.io/apimachinery",
        "k8s.io/client-go"
      ],
      "groupName": "kubernetes-and-controller-runtime"
    }
  ]
}
